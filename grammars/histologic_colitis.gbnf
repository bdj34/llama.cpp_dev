root ::= ("Question: Does the pathology report contain sufficient information? Answer: " 
    ("Yes.\n" jsonarray | "No.") )

jsonarray ::= "```json" ws "[" ws (item (ws "," ws item)*)? ws "]" ws "```"

item ::= ( "{" ws 
    "\"segment\":" ws segmentvalue "," ws 
    "\"reasoning\":" ws limitedstring "," ws 
    "\"histological_severity\":" ws severityvalue "," ws 
    "\"granuloma_detected\":" ws booleanvalue 
    ws "}" )

segmentvalue ::= ( "\"Rectum\"" | "\"Sigmoid\"" | "\"Descending\"" | "\"Splenic Flexure\"" | 
                 "\"Transverse\"" | "\"Hepatic Flexure\"" | "\"Ascending\"" | "\"Cecum\"" | 
                 "\"Unknown (Colon)\"" )

severityvalue ::= "\"Grade 0\"" | "\"Grade 1\"" | "\"Grade 2\"" | "\"Grade 3\"" | "\"Grade 4\""

booleanvalue ::= "true" | "false"

limitedstring ::= "\"" sentence (ws sentence){0,10} "\""

sentence ::= [^".?!;"]+ [.?!;]

ws ::= [ \t\n\r]*
