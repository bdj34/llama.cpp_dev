root ::= "```json\n{" ws stricturekv "," ws pipskv "," ws tubularkv "}" ws "```"

# --- Field Definitions ---
stricturekv ::= "\"stricture\"" ws ":" ws resultobj
pipskv      ::= "\"post_inflammatory_polyps\"" ws ":" ws resultobj
tubularkv   ::= "\"tubular_colon\"" ws ":" ws resultobj

# --- Object Structure (Evidence -> Reasoning -> Value) ---
resultobj ::= "{" ws evidencekv "," ws reasoningkv "," ws valuekv "}"

evidencekv  ::= "\"evidence\"" ws ":" ws stringornull
reasoningkv ::= "\"reasoning\"" ws ":" ws string
valuekv     ::= "\"value\"" ws ":" ws boolean

# --- Primitives ---
boolean        ::= "true" | "false"
stringornull ::= string | "null"

# Standard JSON String definition (handles escapes and disallows newlines \n and carriage returns \r)
string ::= "\"" (
    [^"\\\r\n] |
    "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
)* "\""

# Optional space: by convention, applied in this grammar after literal chars when allowed
ws ::= | " " | "\n" [ \t]{0,20}