root ::= "{" ws stricture_kv "," ws pips_kv "," ws tubular_kv "}" ws

# --- Field Definitions ---
stricture_kv ::= "\"stricture\"" ws ":" ws result_obj
pips_kv      ::= "\"post_inflammatory_polyps\"" ws ":" ws result_obj
tubular_kv   ::= "\"tubular_colon\"" ws ":" ws result_obj

# --- Object Structure (Evidence -> Reasoning -> Value) ---
result_obj ::= "{" ws evidence_kv "," ws reasoning_kv "," ws value_kv "}"

evidence_kv  ::= "\"evidence\"" ws ":" ws string_or_null
reasoning_kv ::= "\"reasoning\"" ws ":" ws string
value_kv     ::= "\"value\"" ws ":" ws boolean

# --- Primitives ---
boolean        ::= "true" | "false"
string_or_null ::= string | "null"

# Standard JSON String definition (handles escapes)
string ::= "\"" (
    [^"\\] |
    "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
)* "\""

# Optional whitespace
ws ::= [ \t\n]{0,5}